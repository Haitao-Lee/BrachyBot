# This is a systemd EnvironmentFile, NOT a shell script. No export or expansion.
# Copy to ~/.config/brachybot/public.env with mode 0600 and replace placeholders.
BRACHYBOT_PUBLIC_ORIGIN=https://CHANGE_ME.example.com
BRACHYBOT_PUBLIC_PORT=18082
BRACHYBOT_PUBLIC_THREADS=16
BRACHYBOT_RUNTIME_DIR=/home/lht/snap/brachyplan/BrachyBot/.runtime-public
BRACHYBOT_API_KEY=CHANGE_ME_INDEPENDENT_RANDOM_SECRET
BRACHYBOT_SECRET_KEY=CHANGE_ME_DIFFERENT_RANDOM_SECRET
BRACHYBOT_ALLOW_SELF_REGISTRATION=0
BRACHYBOT_COOKIE_SECURE=1
BRACHYBOT_REQUIRE_API_KEY=1
BRACHYBOT_TRUST_PROXY=0
BRACHYBOT_TRUST_NETWORK=0
BRACHYBOT_ALLOW_INSECURE_REMOTE=0
# Supply the chosen provider's correct endpoint, model and secret here.
# Do not copy unrelated interactive shell settings or developer tool flags.
