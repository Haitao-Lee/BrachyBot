[Unit]
Description=BrachyBot private production origin (single process)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/lht/snap/brachyplan/BrachyBot
EnvironmentFile=%h/.config/brachybot/public.env
ExecStartPre=/home/lht/.conda/envs/brachytherapy/bin/python -m web.public_server --check
ExecStart=/home/lht/.conda/envs/brachytherapy/bin/python -m web.public_server
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077
LimitNOFILE=65536
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
