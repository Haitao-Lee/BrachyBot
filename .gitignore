# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
env/
tool_factory/env_manager/envs/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter
.ipynb_checkpoints/

# Large model files (download separately)
VoCo/
*.pth
*.ckpt
*.pt
*.onnx
*.bin
*.safetensors
models/ctv/biomedparse_v2/.cache/
models/ctv/biomedparse_v2/clip-vit-base-patch32/
dose_pre/*.pth
dose_pre/*.ckpt

# Data and runtime memory
memory/data/
# Keep the root runtime output directory untracked, but do not hide Python
# source modules named "output". The prior unanchored rule silently excluded
# tool_factory/output/dicom_rt_exporter.py from releases.
/output/
# DICOM/report artifacts emitted by the export tools are runtime data, while
# the Python source modules under tool_factory/output remain versioned.
tool_factory/output/reports/
outputs/
*.nii.gz
*.nii
*.dcm
*.dicom

# Logs
*.log
logs/

# Claude Code
.claude/
.codegraph/

# Uploads (runtime generated)
uploads/
screenshots/
test_screenshots/
tests/depth-peeling-test.png
.runtime/
# Repo-local runtime/archive data (patient/workspace archives); never commit.
runtime/

# Documentation generated for this project is tracked.
brain/knowledge/
skills/data/

# Benchmark results (runtime generated)
web/test/benchmarks/results/
web/test/benchmarks/results_v2/

# OS
.DS_Store
Thumbs.db

# Environment secrets
.env
.env.local
*.key
mykey.py

# Local debug scripts (never committed)
debug_*.py

# Stale patch backups (.orig) and rejected hunks (.rej) are artifacts of
# `patch`/`git apply`, never source. Ignore them everywhere so they can stay
# on disk for recovery without polluting status or risking accidental staging.
*.orig
*.rej

# Local root-level test scripts may contain hardcoded machine paths. The
# maintained pytest suite under tests/ must remain trackable.
/test_*.py

# Benchmark archive scripts (contain hardcoded local paths)
benchmarks/archive/v1_scripts/

# Runtime web search cache (regenerated on demand)
tool_factory/web_search/cache/
tool_factory/web_search/evidence/
tool_factory/case_memory/cases/

# Local run scripts may contain environment-specific ports or secret setup
start_server.sh
*.bak_codex_*
*.bak

# PDF files (not part of codebase)
*.pdf

# Local tooling / transient sync artifacts
.codex-sync/
server_codex_*.pid
