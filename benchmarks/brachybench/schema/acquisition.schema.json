{
  "$id": "https://brachybench.local/schema/acquisition.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EXT Acquisition Manifest v1 (DESIGN §25.4, appendix J)",
  "type": "object",
  "required": ["benchmark","ext_id","tier","grade_R","grade_C","panels","acquisition","runner","adapter","run","isolation","contamination","status"],
  "additionalProperties": false,
  "properties": {
    "benchmark": {"type": "string"},
    "ext_id": {"type": "string", "pattern": "^EXT-[0-9]+$"},
    "tier": {"enum": ["main", "specialty", "conditional"]},
    "grade_R": {"enum": ["R0", "R0-Gated", "R1", "R2"]},
    "grade_C": {"enum": ["C3", "C2", "C1", "C0"]},
    "panels": {"type": "array", "items": {"enum": ["P1","P2","P3","P4","P5","P6","P7","P8","P9"]}, "minItems": 1},

    "acquisition": {
      "type": "object",
      "required": ["source_url","source_commit","dataset_name","dataset_revision","dataset_sha256","dataset_size_bytes","retrieval_command","retrieval_date","license_upstream","license_file","license_verified_by"],
      "properties": {
        "source_url": {"type": "string", "pattern": "^https?://"},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{7,40}$|^<pinned"},
        "source_tag": {"type": ["string", "null"]},
        "dataset_name": {"type": "string"},
        "dataset_revision": {"type": "string"},
        "dataset_sha256": {"type": "string"},
        "dataset_size_bytes": {"type": "integer", "minimum": 0},
        "retrieval_command": {"type": "string"},
        "retrieval_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "license_upstream": {"type": "string"},
        "license_file": {"type": "string"},
        "license_verified_by": {"type": "string"},
        "activity_verified": {
          "type": "object",
          "properties": {
            "last_commit_date": {"type": ["string", "null"]},
            "last_release_date": {"type": ["string", "null"]},
            "open_issues": {"type": ["integer", "null"]}
          }
        }
      }
    },

    "runner": {
      "type": "object",
      "required": ["official_runner", "evaluator"],
      "properties": {
        "official_runner": {"type": "string"},
        "evaluator": {"type": "string"},
        "container": {"type": ["string", "null"]},
        "python_requires": {"type": "string"},
        "native_deps": {"type": "array", "items": {"type": "string"}},
        "paid_apis": {"type": "array", "items": {"type": "string"}}
      }
    },

    "adapter": {
      "type": "object",
      "required": ["kind", "shim_used"],
      "properties": {
        "kind": {"enum": ["ext_adapter", "http", "in_process", "offline_bundle"]},
        "shim_used": {"type": "boolean"},
        "spec_ref": {"type": "string"}
      }
    },

    "run": {
      "type": "object",
      "required": ["smoke_size", "sampling_seed", "n_runs", "budget"],
      "properties": {
        "smoke_size": {"type": "integer", "minimum": 1},
        "sample_size": {"type": "integer", "minimum": 0},
        "sampling_seed": {"type": "integer"},
        "n_runs": {"type": "integer", "minimum": 1},
        "budget": {
          "type": "object",
          "required": ["wall_clock_s", "turns", "tool_calls"],
          "properties": {
            "wall_clock_s": {"type": "number", "minimum": 0},
            "turns": {"type": "integer", "minimum": 0},
            "tool_calls": {"type": "integer", "minimum": 0}
          }
        }
      }
    },

    "isolation": {
      "type": "object",
      "required": ["sandbox", "network", "write_paths", "forbidden_write_roots"],
      "properties": {
        "sandbox": {"enum": ["required", "optional"]},
        "network": {"enum": ["denied", "allowed"]},
        "write_paths": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "forbidden_write_roots": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },

    "contamination": {
      "type": "object",
      "required": ["public_samples_allowed_for_dev_only", "seen_task_ids"],
      "properties": {
        "public_samples_allowed_for_dev_only": {"type": "boolean"},
        "seen_task_ids": {"type": "array", "items": {"type": "string"}},
        "behavioral_probes": {"type": "array", "items": {"type": "string"}}
      }
    },

    "status": {"enum": ["active", "blocked", "excluded"]},
    "block_reason": {"type": ["string", "null"]},
    "reinclude_condition": {"type": ["string", "null"]}
  }
}
